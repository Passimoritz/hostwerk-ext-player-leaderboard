{
  "$schema": "https://raw.githubusercontent.com/Passimoritz/hostwerk-public/main/sdk/manifest.schema.json",
  "id": "player-leaderboard",
  "color": "#eab308",
  "category": "games",
  "name": {
    "de": "Spieler-Bestenliste",
    "en": "Player leaderboard"
  },
  "description": {
    "de": "Wer am meisten spielt, abbaut, besiegt oder stirbt – über alle Minecraft-Server zusammen oder je Server, gesamt oder für Woche und Monat, mit Spielersuche, Profilkarte, Abzeichen und Verlauf. Direkt im Reiter „Spieler“ jedes Minecraft-Servers, als Stream-Ansicht für OBS und auf Wunsch als eigene Webseite in deinem Webserver.",
    "en": "Who plays, mines, kills or dies the most – across all Minecraft servers or per server, all time or for the week and month, with player search, profile card, badges and history. Right in the “Players” tab of every Minecraft server, as a stream view for OBS and, if you like, as an own web page in your web server."
  },
  "permissions": [
    "read:minecraft",
    "read:games",
    "share:view",
    "storage",
    "native"
  ],
  "backend": "server/index.js",
  "publicView": {
    "file": "page/obs.html",
    "title": {
      "de": "Bestenliste (OBS)",
      "en": "Leaderboard (OBS)"
    }
  },
  "page": {
    "title": {
      "de": "Bestenliste",
      "en": "Leaderboard"
    },
    "icon": "trophy",
    "file": "page/index.html",
    "description": {
      "de": "Wer am meisten spielt, abbaut, besiegt oder stirbt – über alle Minecraft-Server zusammen oder je Server, gesamt oder für Woche und Monat, mit Spielersuche, Profilkarte, Abzeichen und Verlauf. Direkt im Reiter „Spieler“ jedes Minecraft-Servers, als Stream-Ansicht für OBS und auf Wunsch als eigene Webseite in deinem Webserver.",
      "en": "Who plays, mines, kills or dies the most – across all Minecraft servers or per server, all time or for the week and month, with player search, profile card, badges and history. Right in the “Players” tab of every Minecraft server, as a stream view for OBS and, if you like, as an own web page in your web server."
    },
    "nav": false,
    "tabs": [
      {
        "id": "board",
        "title": {
          "de": "Bestenliste",
          "en": "Leaderboard"
        },
        "icon": "trophy"
      },
      {
        "id": "stream",
        "title": {
          "de": "Stream-Ansicht",
          "en": "Stream view"
        },
        "icon": "tv"
      },
      {
        "id": "site",
        "title": {
          "de": "Webseite",
          "en": "Web page"
        },
        "icon": "globe"
      }
    ]
  },
  "widget": {
    "title": {
      "de": "Bestenliste",
      "en": "Leaderboard"
    },
    "file": "widget/index.html",
    "size": "third"
  },
  "version": "1.5.1",
  "author": "Hostwerk",
  "homepage": "https://github.com/Passimoritz/hostwerk-ext-player-leaderboard",
  "license": "MIT",
  "icon": "icon.svg",
  "banner": "banner.svg",
  "hostwerk": ">=3.0.0",
  "sdkVersion": "3.0",
  "settings": [
    {
      "key": "metric",
      "type": "select",
      "label": {
        "de": "Standard-Kennzahl",
        "en": "Default metric"
      },
      "default": "playMs",
      "options": [
        {
          "value": "playMs",
          "label": {
            "de": "Spielzeit",
            "en": "Playtime"
          }
        },
        {
          "value": "sessions",
          "label": {
            "de": "Besuche",
            "en": "Visits"
          }
        },
        {
          "value": "mined",
          "label": {
            "de": "Abgebaut",
            "en": "Mined"
          }
        },
        {
          "value": "deaths",
          "label": {
            "de": "Tode",
            "en": "Deaths"
          }
        },
        {
          "value": "mobKills",
          "label": {
            "de": "Monster besiegt",
            "en": "Mobs killed"
          }
        },
        {
          "value": "playerKills",
          "label": {
            "de": "Spieler besiegt",
            "en": "Players killed"
          }
        },
        {
          "value": "distanceKm",
          "label": {
            "de": "Strecke",
            "en": "Distance"
          }
        },
        {
          "value": "crafted",
          "label": {
            "de": "Hergestellt",
            "en": "Crafted"
          }
        }
      ]
    },
    {
      "key": "limit",
      "type": "select",
      "label": {
        "de": "Plätze in der Liste",
        "en": "Places in the list"
      },
      "default": 20,
      "options": [
        {
          "value": 10,
          "label": {
            "de": "Top 10",
            "en": "Top 10"
          }
        },
        {
          "value": 20,
          "label": {
            "de": "Top 20",
            "en": "Top 20"
          }
        },
        {
          "value": 50,
          "label": {
            "de": "Top 50",
            "en": "Top 50"
          }
        },
        {
          "value": 100,
          "label": {
            "de": "Top 100",
            "en": "Top 100"
          }
        }
      ]
    },
    {
      "key": "publicView",
      "type": "switch",
      "label": {
        "de": "Stream-Ansicht ohne Anmeldung freigeben (eigene Adresse für OBS – zeigt Spielernamen und Werte)",
        "en": "Share the stream view without sign-in (own address for OBS – shows player names and values)"
      },
      "default": false
    }
  ],
  "settingsTab": "extensions",
  "allowExtensions": {
    "*": [
      "tabs"
    ]
  },
  "contributes": {
    "sections": [
      {
        "id": "board",
        "title": {
          "de": "Bestenliste",
          "en": "Leaderboard"
        },
        "icon": "trophy",
        "on": "mc.players",
        "file": "page/section.html",
        "height": 820
      }
    ]
  }
}
